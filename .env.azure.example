APP_ENV=production
LOG_LEVEL=INFO

# Database
DATABASE_TYPE=postgres
POSTGRES_DB=jobbot
POSTGRES_USER=jobbot
POSTGRES_PASSWORD=replace-with-a-strong-password
DATABASE_URL=postgresql://jobbot:replace-with-a-strong-password@postgres:5432/jobbot
CV_STORAGE_PATH=/app/data/cvs

# Auth
JWT_SECRET_KEY=replace-with-a-random-secret-min-32-chars

# Telegram
TELEGRAM_TOKEN=
TELEGRAM_BOT_USERNAME=jobs912bot

# Public URLs
LANDING_URL=https://jobbot-app.vercel.app
DASHBOARD_URL=https://app-jobbot.vercel.app
CORS_ORIGINS=https://jobbot-app.vercel.app,https://app-jobbot.vercel.app

# Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_PREMIUM_PRICE_ID=

# AI
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional providers
SERPAPI_KEY=
RAPIDAPI_KEY=
RAPIDAPI_JSEARCH_HOST=jsearch.p.rapidapi.com
RAPIDAPI_JSEARCH_MEGA_HOST=jsearch-mega.p.rapidapi.com
RAPIDAPI_ACTIVE_JOBS_HOST=active-jobs-db.p.rapidapi.com
RAPIDAPI_LINKEDIN_DATA_HOST=linkedin-data-api.p.rapidapi.com
TWITTER_BEARER_TOKEN=

# Product config
SCHEDULER_POLL_MINUTES=10
JOB_BATCH_TTL_MINUTES=30
JOB_BATCH_FALLBACK_MINUTES=35
MAX_JOBS_FREE=5
MAX_JOBS_STARTER=8
MAX_JOBS_PRO=15
MAX_JOBS_PREMIUM=20
SEARCH_COOLDOWN_MINUTES=5

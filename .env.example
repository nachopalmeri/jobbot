# App
APP_ENV=development
LOG_LEVEL=INFO

# Database
DATABASE_TYPE=sqlite
DATABASE_PATH=job_bot.db
DATABASE_URL=
SUPABASE_URL=
SUPABASE_KEY=
CV_STORAGE_PATH=cvs/

# JWT
JWT_SECRET_KEY=replace-with-a-long-random-secret

# Telegram
TELEGRAM_TOKEN=your-telegram-bot-token
TELEGRAM_BOT_USERNAME=jobs912bot
LANDING_URL=https://jobbot-app.vercel.app

# AI
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_PREMIUM_PRICE_ID=
STRIPE_STARTER_YEARLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=
STRIPE_PREMIUM_YEARLY_PRICE_ID=
STRIPE_UNLOCK_PRICE_ID=
STRIPE_25CREDITS_PRICE_ID=
STRIPE_60CREDITS_PRICE_ID=
STRIPE_150CREDITS_PRICE_ID=
STRIPE_CREDITS_WEBHOOK_SECRET=

MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_WEBHOOK_IPS=
MP_STARTER_PRICE_ID=
MP_PRO_PRICE_ID=
MP_PREMIUM_PRICE_ID=
MP_STARTER_YEARLY_PRICE_ID=
MP_PRO_YEARLY_PRICE_ID=
MP_PREMIUM_YEARLY_PRICE_ID=

COINBASE_COMMERCE_KEY=
COINBASE_WEBHOOK_SECRET=

# Optional search APIs
SERPAPI_KEY=
RAPIDAPI_KEY=
TWITTER_BEARER_TOKEN=

# Frontend / deploy
API_URL=http://localhost:8000
DASHBOARD_URL=https://app-jobbot.vercel.app
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://jobbot-app.vercel.app,https://app-jobbot.vercel.app

# Rate limits
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=900
API_RATE_LIMIT=100
API_RATE_WINDOW_SECONDS=60

# Scheduler
SCHEDULER_POLL_MINUTES=10

# Smart Summary UX - Configuracion del nuevo flujo
JOB_BATCH_TTL_MINUTES=30
JOB_BATCH_FALLBACK_MINUTES=35
MAX_JOBS_FREE=5
MAX_JOBS_STARTER=8
MAX_JOBS_PRO=15
MAX_JOBS_PREMIUM=20
SEARCH_COOLDOWN_MINUTES=5

# Company & Financial Data APIs
RAPIDAPI_LINKEDIN_DATA_HOST=linkedin-data-api.p.rapidapi.com
RAPIDAPI_YAHOO_FINANCE_HOST=yahoo-finance166.p.rapidapi.com
COMPANY_CACHE_TTL_SECONDS=604800
FINANCIAL_CACHE_TTL_SECONDS=86400

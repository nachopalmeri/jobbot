# ============================================================
# Job Monitor Bot — Variables de Entorno
# Copiar como .env y completar con tus valores
# ============================================================

# OBLIGATORIO — Token de @BotFather
TELEGRAM_TOKEN=tu_token_aquí

# OPCIONAL — Base de datos (default: sqlite)
# DATABASE_TYPE=sqlite  # O 'supabase'
# DATABASE_PATH=job_bot.db

# SUPABASE (Si usas DATABASE_TYPE=supabase)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your-anon-key
# DATABASE_URL=postgresql://postgres:password@db.supabase.co:5432/postgres

# OPCIONAL — Directorio para guardar CVs (default: cvs/)
# CV_STORAGE_PATH=cvs/

# OPCIONAL — Cada cuántos minutos el scheduler revisa usuarios pendientes (default: 10)
# SCHEDULER_POLL_MINUTES=10

# ============================================================
# APIs OPCIONALES
# ============================================================

# SerpAPI: 100 búsquedas GRATUITAS/mes → https://serpapi.com
# SERPAPI_KEY=tu_key

# Twitter/X: Requiere plan Basic ($100/mes) para búsqueda
# TWITTER_BEARER_TOKEN=tu_bearer_token

# Gemini API: GRATIS (15 req/min) → https://aistudio.google.com/apikey
# Para análisis avanzado de CV con IA
# GEMINI_API_KEY=tu_key

# ============================================================
# LANDING PAGE & STATS
# ============================================================
# STATS_API_PORT=8080
# STATS_API_ENABLED=true
# LANDING_URL=https://jobbot-landing.vercel.app

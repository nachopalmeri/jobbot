# JobBot API - Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# APP CONFIGURATION
# =============================================================================
APP_ENV=development
LOG_LEVEL=INFO
DEBUG=false

# =============================================================================
# DATABASE
# =============================================================================
DATABASE_TYPE=sqlite
DATABASE_PATH=job_bot.db
DATABASE_URL=
SUPABASE_URL=
SUPABASE_KEY=
CV_STORAGE_PATH=cvs/

# SQLite optimization for production
SQLITE_WAL_MODE=true
SQLITE_CONNECTION_POOL_SIZE=20

# =============================================================================
# SECURITY & JWT
# =============================================================================
# IMPORTANT: Use a strong, random secret (minimum 32 characters)
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=replace-with-a-long-random-secret-min-32-chars

# Token configuration
ACCESS_TOKEN_EXPIRE_HOURS=24
REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# REDIS CACHE (Production)
# =============================================================================
# Set to enable Redis caching (production recommended)
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_SIZE=20

# =============================================================================
# TELEGRAM BOT
# =============================================================================
TELEGRAM_TOKEN=your-telegram-bot-token
TELEGRAM_BOT_USERNAME=jobs912bot
LANDING_URL=https://jobbot.ar

# =============================================================================
# AI / LLM
# =============================================================================
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# =============================================================================
# PAYMENTS - STRIPE
# =============================================================================
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_PREMIUM_PRICE_ID=

# =============================================================================
# PAYMENTS - MERCADOPAGO
# =============================================================================
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# Comma-separated list of allowed IPs
MP_WEBHOOK_IPS=18.228.1.56,18.228.4.34,18.228.5.6
MP_STARTER_PRICE_ID=
MP_PRO_PRICE_ID=
MP_PREMIUM_PRICE_ID=

# =============================================================================
# PAYMENTS - COINBASE (Crypto)
# =============================================================================
COINBASE_COMMERCE_KEY=
COINBASE_WEBHOOK_SECRET=

# =============================================================================
# FRONTEND & CORS
# =============================================================================
# API URL for frontend
API_URL=http://localhost:8000
DASHBOARD_URL=http://localhost:3000

# CORS origins - comma-separated list
# Production: https://jobbot.ar,https://www.jobbot.ar,https://app.jobbot.ar
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://jobbot.ar

# =============================================================================
# RATE LIMITING
# =============================================================================
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=900
REGISTER_RATE_LIMIT=3
REGISTER_RATE_WINDOW_SECONDS=60
API_RATE_LIMIT=1000
API_RATE_WINDOW_SECONDS=3600
WEBHOOK_RATE_LIMIT=100
WEBHOOK_RATE_WINDOW_SECONDS=60

# =============================================================================
# OBSERVABILITY & MONITORING
# =============================================================================
# Sentry error tracking (production)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=1.0.0

# Prometheus metrics (optional)
METRICS_ENABLED=false
METRICS_PORT=9090

# Structured logging
STRUCTURED_LOGGING=true
LOG_FORMAT=json

# =============================================================================
# REQUEST LIMITS & SECURITY
# =============================================================================
# Maximum request body size (10MB default)
MAX_REQUEST_SIZE_BYTES=10485760

# IP allowlisting for admin endpoints (comma-separated)
ADMIN_IP_WHITELIST=

# =============================================================================
# EXTERNAL APIS
# =============================================================================
SERPAPI_KEY=
RAPIDAPI_KEY=
RAPIDAPI_LINKEDIN_DATA_HOST=linkedin-data-api.p.rapidapi.com
RAPIDAPI_YAHOO_FINANCE_HOST=yahoo-finance166.p.rapidapi.com
TWITTER_BEARER_TOKEN=

# =============================================================================
# BUSINESS LOGIC CONFIG
# =============================================================================
SCHEDULER_POLL_MINUTES=10

# Job batching
JOB_BATCH_TTL_MINUTES=30
JOB_BATCH_FALLBACK_MINUTES=35

# Plan limits
MAX_JOBS_FREE=5
MAX_JOBS_STARTER=8
MAX_JOBS_PRO=15
MAX_JOBS_PREMIUM=20

# Cooldowns
SEARCH_COOLDOWN_MINUTES=5

# Cache TTLs
COMPANY_CACHE_TTL_SECONDS=604800
FINANCIAL_CACHE_TTL_SECONDS=86400
JOB_CACHE_TTL_SECONDS=300
DASHBOARD_CACHE_TTL_SECONDS=300
